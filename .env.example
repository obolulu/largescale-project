# Copy to .env and adjust. Never commit .env.

# Local Postgres from docker-compose
POSTGRES_USER=billing
POSTGRES_PASSWORD=billing_dev_password
POSTGRES_DB=billing

# Used by billing-api (node-postgres URL)
DATABASE_URL=postgresql://billing:billing_dev_password@localhost:5432/billing

# Optional: run billing-api tests against this server instead of in-process PGlite.
# Use an empty database; the tests drop and recreate the billing tables.
# TEST_DATABASE_URL=postgresql://billing:billing_dev_password@localhost:5432/billing_test

# JWT signing secret for local development only (Phase 2)
JWT_SECRET=local-dev-only-secret-change-me-in-cloud-0001
