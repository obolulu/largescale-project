# Copy to .env and adjust. Never commit .env.

# Local Postgres from docker-compose
POSTGRES_USER=billing
POSTGRES_PASSWORD=billing_dev_password
POSTGRES_DB=billing

# Used by billing-api (SQLAlchemy URL, psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://billing:billing_dev_password@localhost:5432/billing

# JWT signing secret for local development only (Phase 2)
JWT_SECRET=change-me-local-dev-only
