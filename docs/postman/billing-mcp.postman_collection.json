  "item": [
    {
      "name": "1 Initialize (saves the session ID)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The server answers as an event stream (event: message / data: {...}); take the JSON from the data line.",
              "const text = pm.response.text();",
              "const dataLine = text.split(/\\r?\\n/).find((l) => l.startsWith(\"data:\"));",
              "const msg = JSON.parse(dataLine ? dataLine.slice(5) : text);",
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"server is billing-docs\", () => pm.expect(msg.result.serverInfo.name).to.eql(\"billing-docs\"));",
              "pm.test(\"offers tools\", () => pm.expect(msg.result.capabilities).to.have.property(\"tools\"));",
              "const sessionId = pm.response.headers.get(\"mcp-session-id\");",
              "pm.test(\"returns a session ID\", () => pm.expect(sessionId).to.be.a(\"string\").and.not.empty);",
              "const store = pm.environment.name ? pm.environment : pm.collectionVariables;",
              "store.set(\"mcp_session\", sessionId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json, text/event-stream"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"initialize\",\n  \"params\": {\n    \"protocolVersion\": \"2025-06-18\",\n    \"capabilities\": {},\n    \"clientInfo\": {\n      \"name\": \"postman\",\n      \"version\": \"1.0.0\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{mcp}}"
      }
    },
