    {
      "name": "Chat (Claude + this MCP server, needs an Anthropic API key)",
      "description": "Not run by the plain-JSON-RPC steps above. Set anthropic_api_key and question in the collection Variables tab.",
      "item": [
        {
          "name": "Chat with Claude (Claude calls this MCP server)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Edit the question in the collection's Variables tab (or the environment).",
                  "const question = pm.variables.get(\"question\") || \"How much does extra internet cost?\";",
                  "pm.variables.set(\"question_json\", JSON.stringify(question));",
                  "if (!pm.variables.get(\"anthropic_api_key\")) {",
                  "  // Skip quietly in a collection run without a key; a single Send shows this message.",
                  "  console.warn(\"Set anthropic_api_key in the collection's Variables tab first. Skipping the chat request.\");",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "if (pm.response.code !== 200) { console.log(r); return; }",
                  "const calls = r.content.filter((b) => b.type === \"mcp_tool_use\");",
                  "const results = r.content.filter((b) => b.type === \"mcp_tool_result\");",
                  "const answer = r.content.filter((b) => b.type === \"text\").map((b) => b.text).join(\"\\n\");",
                  "pm.test(\"Claude called the MCP server\", () => pm.expect(calls.length).to.be.above(0));",
                  "pm.test(\"answer is not empty\", () => pm.expect(answer).to.not.be.empty);",
                  "console.log(\"Q: \" + pm.variables.get(\"question\"));",
                  "calls.forEach((c) => console.log(\"tool call: \" + c.name + \" \" + JSON.stringify(c.input)));",
                  "console.log(\"A: \" + answer);",
                  "",
                  "// Visualize tab: the answer, the tool calls and token usage.",
                  "const esc = (s) => String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\");",
                  "pm.visualizer.set(`",
                  "<style>body{font-family:sans-serif;max-width:760px;margin:16px;line-height:1.5}",
                  ".q{color:#555}.a{white-space:pre-wrap;background:#f4f6fa;padding:12px;border-radius:6px}",
                  "code{background:#eee;padding:1px 4px;border-radius:3px}small{color:#777}</style>",
                  "<p class=q><b>You:</b> {{q}}</p><div class=a>{{{a}}}</div>",
                  "<h4>Tool calls</h4><ul>{{#each calls}}<li><code>{{this}}</code></li>{{/each}}</ul>",
                  "<small>{{model}} · {{inTok}} input / {{outTok}} output tokens · stop: {{stop}}</small>`, {",
                  "  q: pm.variables.get(\"question\"),",
                  "  a: esc(answer),",
                  "  calls: calls.map((c, i) => c.name + \" \" + JSON.stringify(c.input) + (results[i] && results[i].is_error ? \"  (error)\" : \"\")),",
                  "  model: r.model, inTok: r.usage.input_tokens, outTok: r.usage.output_tokens, stop: r.stop_reason,",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{anthropic_api_key}}"
              },
              {
                "key": "anthropic-version",
                "value": "2026-10-21"
              },
              {
                "key": "anthropic-beta",
                "value": "mcp-client-2025-11-20,server-side-fallback-2026-07-01"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{chat_model}}\",\n  \"max_tokens\": 4000,\n  \"output_config\": { \"effort\": \"low\" },\n  \"fallbacks\": \"default\",\n  \"system\": \"You are a billing support assistant for a mobile provider. Answer questions about billing rules from the Mobile Provider Billing Guide, using the search_billing_documentation tool, and cite section references such as §3.2. You have no access to the customer's account, bills or usage; if asked about them, say that the agent CLI or the Billing API handles account data. Keep answers short.\",\n  \"mcp_servers\": [\n    { \"type\": \"url\", \"url\": \"{{mcp_public}}\", \"name\": \"billing-docs\" }\n  ],\n  \"tools\": [\n    { \"type\": \"mcp_toolset\", \"mcp_server_name\": \"billing-docs\" }\n  ],\n  \"messages\": [\n    { \"role\": \"user\", \"content\": {{question_json}} }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "https://api.anthropic.com/v1/messages",
            "description": "Ask Claude a billing question in plain English. Claude calls search_billing_documentation on the deployed MCP server through Anthropic's MCP connector, then answers with section references. Set anthropic_api_key and question in the collection's Variables tab, send, and open the Visualize tab. One question per send (no memory between sends). Anthropic's servers make the MCP call, so this always uses the public Azure MCP URL (mcp_public), never localhost. Costs a fraction of a cent per question."
          }
        }
      ]
    }
  ]
}
