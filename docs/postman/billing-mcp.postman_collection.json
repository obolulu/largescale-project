{
  "info": {
    "name": "SE4458 Billing Docs MCP server",
    "description": "The billing documentation MCP server, called with plain JSON-RPC over Streamable HTTP, so it runs in the collection runner and newman. Run the requests in order: Initialize saves the session ID (the mcp-session-id header) that every later request sends. Works with the \"Billing - Azure\" or \"Billing - Local (docker compose)\" environment from docs/postman/; without one, it defaults to Azure. On Azure the first request can take ~40 s while the app wakes. Nothing here changes data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "mcp",
      "value": "https://billing-mcp.orangeplant-9349f6a6.swedencentral.azurecontainerapps.io/mcp"
    },
    {
      "key": "mcp_session",
      "value": ""
    },
    {
      "key": "mcp_public",
      "value": "https://billing-mcp.orangeplant-9349f6a6.swedencentral.azurecontainerapps.io/mcp"
    },
    {
      "key": "anthropic_api_key",
      "value": "",
      "type": "secret"
    },
    {
      "key": "chat_model",
      "value": "claude-opus-5-5"
    },
    {
      "key": "question",
      "value": "How much does extra internet cost?"
